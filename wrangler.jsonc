{
  // The site and the contact form backend, deployed together as one Worker.
  // Static pages are served from the repo root; .assetsignore keeps the rest out.
  "name": "tpn-landing",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "tpn-forms", "database_id": "c5180dd8-8e72-4b7d-96c5-c5e946dc5208" }
  ],
  "vars": {
    // Comma-separated list of who gets an email for every enquiry.
    "NOTIFY_TO": "sanaa@thepineapplenation.com,sabareesh@thepineapplenation.com",
    // Must be on a domain verified in Resend.
    "NOTIFY_FROM": "The Pineapple Nation website <website@send.thepineapplenation.com>"
  },
  // Secrets, set in the dashboard or with `wrangler secret put`:
  // RESEND_API_KEY, ADMIN_PASSWORD, TURNSTILE_SECRET (optional)
  "observability": { "enabled": true }
}
